# Formspree form ID (the part after /f/ in your form's endpoint URL:
# https://formspree.io/f/xxxxxxxx). Defaults to "xrewjqdr" (hardcoded in
# components/ContactForm.tsx) if this isn't set. Only set this if you
# create a different Formspree form and want to point the site at it.
NEXT_PUBLIC_FORMSPREE_ID=
