# Where enquiry / viewing-request form submissions go: json | resend | webhook | console
# (json writes data/enquiries.json — fine locally, but Vercel's filesystem is read-only)
ENQUIRY_STORE=json

# ENQUIRY_STORE=resend
RESEND_API_KEY=
ENQUIRY_TO=you@youragency.com
ENQUIRY_FROM=Website <enquiries@youragency.com>

# ENQUIRY_STORE=webhook
ENQUIRY_WEBHOOK_URL=

# Absolute site URL, used for social share images
NEXT_PUBLIC_SITE_URL=https://example.com
